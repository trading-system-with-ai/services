# Copy to .env and fill in. NEVER commit .env.
ENVIRONMENT=dev

# Database (docker-compose default shown)
DATABASE_URL=postgresql+asyncpg://trading:trading@localhost:5432/trading
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Market data
#
# MASSIVE IS THE ONLY SUPPORTED REAL MARKET-DATA SOURCE. Everything the
# platform shows is Massive raw data or computed from it.
#
# MARKET_DATA_PROVIDER selects the provider and has NO DEFAULT. Leave it EMPTY
# and the platform has no market data: /api/market/overview, the analysis /
# bars / options views, order preview / approve / close, backtests and the exit
# sweep all answer HTTP 503 MARKET_DATA_NOT_CONFIGURED, GET /api/positions and
# GET /api/portfolio/risk still report your real DB rows with null price
# fields, and the background position monitor skips its sweeps. That is
# deliberate: showing NOTHING is correct, showing invented numbers is not.
#
#   (empty)  no market data — the platform shows nothing rather than fake data
#   massive  the real Massive feed (requires MASSIVE_API_KEY)
#   stub     LOCAL DEVELOPMENT AND TESTS ONLY — synthetic, seeded, NON-MARKET
#            numbers that look real. Never set this in any shared, staging or
#            production environment.
MARKET_DATA_PROVIDER=
MASSIVE_API_KEY=

# ---------------------------------------------------------------------------
# LLM provider (recommendations only — LLM has zero execution authority)
#
# LLM_PROVIDER also has NO DEFAULT. Leave it EMPTY and
# POST /api/recommendations/refresh answers HTTP 503 LLM_NOT_CONFIGURED and
# creates nothing — no template-generated drafts that read like real research.
#
#   (empty)    no recommendations
#   openai     the real OpenAI-backed provider (requires LLM_API_KEY)
#   anthropic  the real Anthropic-backed provider (requires LLM_API_KEY)
#   stub       LOCAL DEVELOPMENT AND TESTS ONLY — template-generated drafts
#              with no model call and no analysis behind them.
#
# LLM_MODEL must match the chosen provider — there is no cross-provider
# translation. Current flagship model ids (verify before pinning; model
# lineups move faster than this file):
#   openai     gpt-5.6-sol (flagship) | gpt-5.6-terra (balanced) | gpt-5.6-luna (cheap)
#   anthropic  claude-opus-5 | claude-sonnet-5 | claude-haiku-4-5
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-5.6-sol

# Broker (unused until Phase 6 paper trading)
BROKER_API_KEY=
BROKER_API_SECRET=

# Global kill switch default
TRADING_ENABLED=false
