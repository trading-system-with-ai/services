# Copy to .env and fill in. NEVER commit .env.
ENVIRONMENT=dev

# Database (docker-compose default shown).
# The password below is the LOCAL DEVELOPMENT default from docker-compose.yml.
# Change it — and the matching POSTGRES_PASSWORD — before exposing Postgres
# anywhere other than your own machine.
DATABASE_URL=postgresql+asyncpg://trading:trading@localhost:5432/trading
REDIS_URL=redis://localhost:6379/0

# Host port for the API. The container always listens on 8000; this only
# moves the HOST side, for when 8000 is already taken locally.
GATEWAY_PORT=8000

# ---------------------------------------------------------------------------
# Market data
#
# ALPACA IS THE AUTHORITATIVE MARKET-DATA SOURCE (docs/
# data-source-architecture.md): stocks, options and news. Massive is
# reserved for company fundamentals; the massive market-data adapter stays
# selectable only for installs still keyed to it. NO silent cross-provider
# fallback, ever.
#
# MARKET_DATA_PROVIDER selects the provider and has NO DEFAULT. Leave it EMPTY
# and the platform has no market data: /api/market/overview, the analysis /
# bars / options views, order preview / approve / close, backtests and the exit
# sweep all answer HTTP 503 MARKET_DATA_NOT_CONFIGURED, GET /api/positions and
# GET /api/portfolio/risk still report your real DB rows with null price
# fields, and the background position monitor skips its sweeps. That is
# deliberate: showing NOTHING is correct, showing invented numbers is not.
#
#   (empty)  no market data — the platform shows nothing rather than fake data
#   alpaca   the Alpaca Market Data API (authoritative; uses the SAME
#            ALPACA_API_KEY_ID / ALPACA_API_SECRET_KEY as the broker)
#   massive  the Massive feed (requires MASSIVE_API_KEY) — legacy for market
#            data; Massive's role in this architecture is fundamentals
#   stub     LOCAL DEVELOPMENT AND TESTS ONLY — synthetic, seeded, NON-MARKET
#            numbers that look real. Never set this in any shared, staging or
#            production environment.
#
# NOTE: on an existing install the UI-managed runtime config (DB) OVERRIDES
# these lines — switch providers in Settings -> Connections, not here.
MARKET_DATA_PROVIDER=
MASSIVE_API_KEY=

# ---------------------------------------------------------------------------
# LLM provider (recommendations only — LLM has zero execution authority)
#
# LLM_PROVIDER also has NO DEFAULT. Leave it EMPTY and
# POST /api/recommendations/refresh answers HTTP 503 LLM_NOT_CONFIGURED and
# creates nothing — no template-generated drafts that read like real research.
#
#   (empty)    no recommendations
#   openai     the real OpenAI-backed provider (requires LLM_API_KEY)
#   anthropic  the real Anthropic-backed provider (requires LLM_API_KEY)
#   stub       LOCAL DEVELOPMENT AND TESTS ONLY — template-generated drafts
#              with no model call and no analysis behind them.
#
# LLM_MODEL must match the chosen provider — there is no cross-provider
# translation. Current flagship model ids (verify before pinning; model
# lineups move faster than this file):
#   openai     gpt-5.6-sol (flagship) | gpt-5.6-terra (balanced) | gpt-5.6-luna (cheap)
#   anthropic  claude-opus-5 | claude-sonnet-5 | claude-haiku-4-5
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-5.6-sol

# HTTP read timeout (SECONDS) for the pre-event EVENT ANALYSIS call only.
# The discovery calls (recommendations refresh/enrich) keep their own 60s.
# An analysis prompt carries the whole evidence bundle and asks for a long
# structured note: a live gpt-5.6-sol run took 51s, and at a 60s timeout the
# next one hit ReadTimeout and was stored as a FAILED analysis AFTER paying
# for the inference. Raise this, not the shared timeout — a hung
# recommendations refresh should not sit for four minutes.
LLM_ANALYSIS_TIMEOUT_SECONDS=240

# ---------------------------------------------------------------------------
# Broker / order execution
#
# LIVE TRADING IS DELIBERATELY NOT SUPPORTED. There is no provider name, no
# URL and no flag in this file that reaches a live account. The Alpaca adapter
# refuses any host but paper-api.alpaca.markets at construction (a hard startup
# failure naming the host) and re-verifies with Alpaca that the account is a
# paper account before every single order. Going live would require editing
# libs/broker/alpaca.py — that friction is the feature.
#
# BROKER_PROVIDER has NO DEFAULT, exactly like the two providers above. Leave
# it EMPTY and the platform places NOTHING: POST /api/orders/approve and
# POST /api/orders/close answer HTTP 503 BROKER_NOT_CONFIGURED, and the exit
# sweep (POST /api/positions/check-exits + the background monitor) skips with a
# warning instead of closing positions locally. There is NO silent fallback to
# the internal fill simulator: a simulated fill reported as a broker fill would
# be an execution that never happened, presented as one that did.
#
#   (empty)       no execution — nothing is placed, nothing is closed
#   alpaca_paper  a REAL Alpaca PAPER account (requires the two keys below)
#   simulated     DEVELOPMENT / BACKTEST-COMPARISON ONLY — the internal §11
#                 paper fill model. No broker is contacted and no order exists
#                 anywhere outside this database. Never set this in any shared,
#                 staging or production environment.
#
# Options: LONG_STOCK, LONG_CALL and LONG_PUT all execute at the broker.
# Options ride the same order endpoint as equities, addressed by their OCC
# contract symbol (e.g. "NVDA  260918C00150000") and counted in CONTRACTS,
# with cash and max loss carrying the 100x multiplier. Requires an Alpaca
# account approved for long options. The platform stays long-only (§5): there
# is no Sell-to-Open anywhere, so covered calls, cash-secured puts and spreads
# are NOT supported — those need short legs, new max-loss models and new exit
# rules (a Phase 9 change, not a configuration flag).
BROKER_PROVIDER=

# Alpaca PAPER credentials — generate them at https://app.alpaca.markets under
# the PAPER account (paper keys typically start with "PK"). They are only ever
# sent to paper-api.alpaca.markets and are never logged or echoed by any API
# response; GET /api/broker/status reports the account NUMBER (an identifier)
# and never the keys.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# Order-sync sweep (guide §11): how often non-terminal broker orders
# (PENDING_SUBMIT / ACCEPTED / PARTIALLY_FILLED) are re-checked at the broker
# and their real fills applied. 0 disables the background loop (the manual
# POST /api/broker/sync-orders always works). No-op without a real broker.
ORDER_SYNC_INTERVAL_SECONDS=30

# Periodic reconciliation (guide §13): how often the whole broker ledger is
# compared against local rows. A material mismatch PAUSES trading through the
# §18 kill switch — same code path as GET /api/broker/reconcile. 0 disables.
RECONCILIATION_INTERVAL_SECONDS=300

# Statistical risk snapshot writer (Risk Engine Upgrade Phase B): how often
# the background loop persists ONE SCHEDULED risk snapshot per
# America/New_York calendar day — the NAV series live drawdown is measured
# on. SHADOW: nothing it computes can alter a risk decision. 0 disables the
# loop (the ON_DEMAND build behind GET /api/portfolio/risk always runs).
RISK_SNAPSHOT_INTERVAL_SECONDS=1800

# ---------------------------------------------------------------------------
# Account permissions (guide §2, §8) — hard cash-account constraints, enforced
# in ALL environments including Alpaca Paper. The platform's AccountPermissions
# object is the source of truth; Alpaca Paper capability does NOT override
# platform permissions, and permissions are never inferred from the broker.
#
# The first four are REAL flags: flipping one re-derives the §8 instrument
# matrix. Spreads stay OFF until the account is explicitly approved for them.
ALLOW_LONG_STOCK=true
ALLOW_LONG_CALL=true
ALLOW_LONG_PUT=true
ALLOW_DEFINED_RISK_SPREADS=false

# The five below are DISPLAY-AND-REFUSE flags: setting ANY of them to true is
# HARD-REJECTED at startup (guide §33, non-negotiable rules) — the process
# fails with an error naming the flag. This platform cannot execute short
# stock, naked short options, covered calls or cash-secured puts: no
# Sell-to-Open and no margin code path exists anywhere. The flags exist to
# make the restriction explicit in this file, not to lift it. (There is no
# ALLOW_MARGIN flag at all — nothing margin-dependent exists to enable.)
ALLOW_SHORT_STOCK=false
ALLOW_NAKED_SHORT_CALL=false
ALLOW_NAKED_SHORT_PUT=false
ALLOW_COVERED_CALL=false
ALLOW_CASH_SECURED_PUT=false

# Global kill switch default
TRADING_ENABLED=false

# --- Catalyst & Event Intelligence (event calendar) ---
# SEC EDGAR requires a descriptive User-Agent WITH a contact e-mail (fair access
# policy); without it www.sec.gov answers 403 and earnings history is skipped.
SEC_USER_AGENT="your-app-name/0.1 (you@example.com)"
# Event calendar ingest cadence in seconds (0 disables the loop); T-minus alert horizon in days.
EVENT_CALENDAR_INTERVAL_SECONDS=3600
EVENT_HORIZON_ALERT_DAYS=7

# --- External research: web search + prediction markets (RESEARCH ONLY) ---
# These providers feed the event Evidence Bundle and NOTHING else: no code
# path from either reaches instrument selection, risk, the gate chain or
# order submission (enforced structurally by the research safety tests).
# Both selectors default to UNSET — the web-research / prediction-market
# sections of event research then report NOT_CONFIGURED honestly while every
# other event surface keeps working (capability-by-capability degradation).
#
# Web search: "brave" needs a Brave Search API key (https://brave.com/search/api/).
# The key is server-side only — never sent to the browser, never echoed by
# any API response. "stub" is synthetic (dev/tests), opt-in only.
WEB_SEARCH_PROVIDER=
BRAVE_API_KEY=
# Prediction markets: "polymarket" uses Polymarket's PUBLIC read APIs (Gamma
# discovery + CLOB pricing) — keyless, read-only, NO wallet and NO trading
# credentials (the subsystem has no trading surface at all). Keyless does not
# mean default-on: enabling an outbound market-data dependency is a conscious
# choice. "stub" is synthetic (dev/tests), opt-in only.
PREDICTION_MARKETS_PROVIDER=
